          "name": "Sair (garante que não há sessão) (204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logout.php",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout.php"
              ]
            },
            "description": "Encerra qualquer sessão anterior para começar do zero."
          }
        },
        {
          "name": "Listar clínicas sem login (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Resposta em JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "pm.test(\"Pede login\", () => pm.expect(pm.response.json().erro).to.eql(\"Faça login.\"));"
