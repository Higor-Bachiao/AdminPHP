                  "pm.test(\"Resposta em JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "pm.test(\"Retorna uma lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clinicas.php",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clinicas.php"
              ]
            },
            "description": "Lista todas as clínicas em JSON."
          }
        },
        {
          "name": "Criar clínica (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gera um CNPJ aleatório para o POST nunca bater em \"CNPJ já cadastrado\"",
                  "pm.collectionVariables.set(\"cnpjTeste\", Array.from({length: 14}, () => Math.floor(Math.random() * 10)).join(\"\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Resposta em JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "pm.test(\"Retorna o id\", () => pm.expect(pm.response.json().id).to.be.a(\"number\"));",
                  "pm.collectionVariables.set(\"clinicaId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clinicas.php",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clinicas.php"
              ]
            },
            "description": "Cria uma clínica. CNPJ e telefone podem vir com máscara: são gravados só com dígitos. Responde **201** com a clínica criada.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Clínica Demonstração\",\n  \"cnpj\": \"{{cnpjTeste}}\",\n  \"email\": \"contato@demo.com\",\n  \"telefone\": \"(35) 99999-0000\",\n  \"cidade\": \"Guaxupé\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Buscar a clínica criada (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Resposta em JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "pm.test(\"Mesmo id\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"clinicaId\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clinicas.php?id={{clinicaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clinicas.php"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "{{clinicaId}}"
                }
              ]
            },
            "description": "Busca pelo id que o POST devolveu."
          }
        },
        {
