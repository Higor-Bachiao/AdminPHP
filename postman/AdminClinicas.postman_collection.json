          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clinicas.php?id={{clinicaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clinicas.php"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "{{clinicaId}}"
                }
              ]
            },
            "description": "Admin exclui. **204 No Content**: deu certo e não há corpo na resposta."
          }
        }
      ]
