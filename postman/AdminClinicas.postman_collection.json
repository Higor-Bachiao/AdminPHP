    {
      "name": "3. Admin → CRUD de clínicas",
      "description": "O ciclo inteiro de uma clínica: **criar → buscar → atualizar → excluir**. O id criado no POST é guardado na variável `clinicaId` e usado nas próximas.",
      "item": [
        {
          "name": "Entrar como admin (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Resposta em JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "pm.test(\"Perfil admin\", () => pm.expect(pm.response.json().perfil).to.eql(\"admin\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login.php",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login.php"
              ]
            },
            "description": "Faz login como **administrador**. O Postman guarda o cookie `PHPSESSID` e o reenvia nas próximas requisições.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@clinica.com\",\n  \"senha\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar clínicas (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
