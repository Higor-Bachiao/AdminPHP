          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clinicas.php?id={{clinicaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clinicas.php"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "{{clinicaId}}"
                }
              ]
            },
            "description": "Atualiza todos os campos e devolve a clínica já atualizada.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Clínica Demonstração (editada)\",\n  \"cnpj\": \"{{cnpjTeste}}\",\n  \"email\": \"contato@demo.com\",\n  \"telefone\": \"(35) 99999-0000\",\n  \"cidade\": \"Franca\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
